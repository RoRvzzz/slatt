// Run after the MoonSec frontend has decoded and classified its handlers.
pass recover {
  match [MOVE($r, $r)] => [];
  fold constants;

  match [BR_EQ($left, $right, $yes, $no)]
    where const($left) == const($right) => [JUMP($yes)],
    where const($left) != const($right) => [JUMP($no)];

  thread jumps;
  prune unreachable;
  dce;
}
