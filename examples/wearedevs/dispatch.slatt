include "bootstrap.slatt";

frontend
fn dispatch_test(at, pc) {
    let op;
    let rhs;
    if this[at] == pc {
        op = this[at+1];
        if op != "<" && op != ">" { return (); }
        rhs = this.integer_expr(at+2);
        if this[rhs[1]] != "then" { return (); }
        return [pc + " " + op + " " + rhs[0].to_string(),rhs[1]+1];
    }
    let lhs = this.integer_expr(at);
    op = this[lhs[1]];
    if (op != "<" && op != ">") || !this.matches_at(lhs[1]+1,[pc,"then"]) {
        return ();
    }
    [lhs[0].to_string() + " " + op + " " + pc,lhs[1]+3]
}

fn try_dispatch_test(at, pc) {
    try { return this.dispatch_test(at,pc); } catch { return (); }
}

fn branch_end(at) {
    let open = [];
    let limit = this.len;
    while at < limit {
        let token = this[at];
        switch token {
            "elseif" | "else" => { if open.is_empty() { return at; } }
            "if" | "function" => open.push("end"),
            "while" | "for" => open.push("do"),
            "repeat" => open.push("until"),
            "do" => {
                if !open.is_empty() && open[open.len-1] == "do" { open.pop(); }
                open.push("end");
            }
            "end" | "until" => {
                if open.is_empty() && token == "end" { return at; }
                if open.is_empty() || open.pop() != token { throw "unbalanced WeAreDevs handler"; }
            }
        }
        at += 1;
    }
    throw "unterminated WeAreDevs handler";
}

fn handler_branch(begin, pc) {
    if this[begin] == "if" {
        let test = this.try_dispatch_test(begin+1,pc);
        if test != () {
            let nested = this.dispatch_tree(test,pc);
            if ["elseif","else","end"].contains(this[nested[2]]) { return nested; }
        }
    }
    let end = this.branch_end(begin);
    [begin.to_string(),[[begin,end]],end]
}

fn dispatch_tree(test, pc) {
    let left = this.handler_branch(test[1],pc);
    let at = left[2];
    let right;
    if this[at] == "elseif" {
        let next = this.try_dispatch_test(at+1,pc);
        if next == () { throw "unsupported WeAreDevs dispatcher elseif"; }
        right = this.dispatch_tree(next,pc);
    } else {
        right = this.handler_branch(this.require_tokens(at,["else"]),pc);
        right[2] = this.require_tokens(right[2],["end"]);
    }
    // Both arms return a positive block ID, so Lua selects exactly one subtree.
    ["(" + test[0] + " and " + left[0] + " or " + right[0] + ")",
     left[1] + right[1],right[2]]
}

fn token_text(begin, end) {
    if type_of(this) == "LuaTokenBuffer" { return this.join_lua_tokens(begin,end); }
    let output = "";
    for at in begin..end { output += this[at] + " "; }
    output
}

fn rewrite_dispatch(source) {
    let banner = "--[[ v1.0.0 https://wearedevs.net/obfuscator ]]";
    let text = source;
    text.trim();
    if !source.starts_with(banner) || text.contains("\n") || text.contains("\r") {
        throw "unsupported WeAreDevs source profile (expected single-line v1.0.0)";
    }
    this.require_tokens(0,["return","(","function","(","...",")","local"]);
    let begin = this.seek(7,["return","(","function","("]);
    let loop_at = -1;
    let tree;
    let next_loop = this.index_of("while",begin);
    while next_loop >= 0 && next_loop+5 < this.len {
        let at = next_loop;
        next_loop = this.index_of("while",at+1);
        if !this.matches_at(at+2,["do","if"]) { continue; }
        let pc = this[at+1];
        let test = this.try_dispatch_test(at+4,pc);
        if test == () { continue; }
        let candidate = ();
        try { candidate = this.dispatch_tree(test,pc); } catch { continue; }
        if candidate[1].len < 4 || this[candidate[2]] != "end" { continue; }
        if loop_at >= 0 { throw "ambiguous WeAreDevs VM dispatcher"; }
        loop_at = at;
        tree = candidate;
    }
    if loop_at < 0 { throw "unsupported WeAreDevs VM dispatcher"; }
    let id = "__slatt_block";
    while this.contains(id) { id += "_"; }
    let pool = ();
    try { pool = this.materialize_pool(begin); } catch { }
    let label = if pool == () { "" } else { "; decoded pool" };
    let prefix = if pool == () { this.token_text(0,loop_at+3) }
                 else { pool + this.token_text(begin,loop_at+3) };
    let output = "--[[ WeAreDevs structural lift: " + tree[1].len.to_string() + " VM blocks" + label + " ]] "
                 + prefix + "local " + id + " = " + tree[0] + " ; ";
    let keyword = "if";
    for block in tree[1] {
        output += keyword + " " + id + " == " + block[0].to_string() + " then ";
        output += this.token_text(block[0],block[1]);
        keyword = "elseif";
    }
    output + "end " + this.token_text(tree[2],this.len) + "\n"
}
%%
