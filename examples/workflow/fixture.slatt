frontend
let image = bytes("SLVM");
let records = [
    [2, 0, 0, 6, 99,104,111,111,115,101, 3, 0,1,2],
    [2, 7, 1,2,255,7, 4, 3],
    [2, 7, 1,2,255,9, 4, 3],
    [5, 0, 2,6,114,101,110,100,101,114, 5, 2,2,1,3,4,1,
        0, 5,5,112,114,105,110,116, 5, 5,0,1,3, 6, 3,3,4,1],
];
image.push(records.len);
for record in records { for byte in record { image.push(byte); } }

let script = "local data = buffer.fromstring(" + lua_quote(image) + ")\n" +
             "__slatt_dump('image', data)\n";
let captured = luau_capture(script, "", "=packed-fixture");
if !captured.report.ok { throw captured.report.error; }
captured.artifacts.image
%%
