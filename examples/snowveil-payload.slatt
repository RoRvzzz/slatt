frontend
fn snowveil_outer_streams(tokens) {
    let alphabet_at = tokens.index_of("Nur", 0);
    if alphabet_at < 1 || tokens.join_lua_tokens(alphabet_at-1,alphabet_at+2) != "local Nur = " {
        throw "SnowVeil outer alphabet declaration missing";
    }
    let literal = bytes(tokens[alphabet_at+2]);
    if literal.len != 87 || literal[0] != 34 || literal[86] != 34 { throw "invalid SnowVeil outer alphabet literal"; }
    let alphabet = literal.extract(1,85);
    let record_at = tokens.index_of("act", alphabet_at+3);
    if record_at < 1 || tokens.join_lua_tokens(record_at-1,record_at+3) != "local act = { " {
        throw "SnowVeil outer stream declaration missing";
    }
    let at = record_at+3;
    let streams = [];
    while tokens[at] != "}" {
        let token = tokens[at];
        let raw = bytes(token);
        if raw.len < 2 || raw[0] != 34 || raw[raw.len-1] != 34 { throw "invalid SnowVeil outer literal"; }
        let data = raw.extract(1,raw.len-2);
        let decoded = data.decode_base85(alphabet,false);
        streams.push(#{input_size: data.len, decoded_size: decoded.len, sha256: sha256(decoded)});
        at += 1;
        if tokens[at] == "," { at += 1; }
        else if tokens[at] != "}" { throw "invalid SnowVeil outer stream separator"; }
    }
    if streams.len != 3 { throw "unexpected SnowVeil outer stream count"; }
    streams
}

if !source.starts_with("-- This file was generated using SnowVeil v3.9 [") {
    throw "expected a SnowVeil v3.9 loader";
}
let entry = `if not oNgs or type(PM)~="table" then return end;Ok=PM;return fCq3(...)end)(...)`;
let stop = `if not oNgs then error(PM,0) end;return PM end)(...)`;
let bootstrap = replace_once(source, entry, stop);
let streams = snowveil_outer_streams(lua_token_buffer(source));
if source_output { throw "SnowVeil application payload lift requires the second VM configuration"; }
let report = luau_trace(bootstrap, host_fixture, "=snowveil-bootstrap");
report.outer_streams = streams;
report
%%
