frontend
// shortcut: audited one-stage loader graph, extend with verified IronBrew1 dispatchers.
fn codebook(size, literals, delta) {
    let count = this.read_gamma()-1;
    if count == 0 { return (); }
    if count > size { throw "invalid IronBrew1 Huffman alphabet size"; }
    let lengths = blob(size, 0);
    let previous = -1;
    let width = 0;
    for i in 0..count {
        let symbol = if literals && (!delta || i == 0) {
            this.read_bits(8)
        } else {
            let step = this.read_gamma();
            if delta { previous + step } else { step - 1 }
        };
        if !delta || i == 0 || this.read_bits(1) == 0 { width = this.read_gamma(); }
        if symbol >= size || width > 24 || lengths[symbol] != 0 {
            throw "invalid IronBrew1 Huffman alphabet entry";
        }
        lengths[symbol] = width;
        previous = symbol;
    }
    lengths.canonical_huffman()
}

fn decode_rice(limit, widths, nibble) {
    let ranks = blob();
    let first = this.codebook(296, false, false);
    let after_zero = this.codebook(296, false, false);
    let values = this.codebook(256, true, false);
    if !nibble || this.read_bits(1) == 0 {
        for i in 0..4 { widths[i] = this.read_bits(4); }
    }
    let zero = false;
    loop {
        let op = this.read_huffman(if zero { after_zero } else { first });
        if op == 295 { break; }
        let count = 1;
        let rank = op;
        if op == 256 || op == 257 {
            rank = if op == 256 { this.read_huffman(values) } else { 0 };
            let width = widths[(if op == 256 { 2 } else { 0 }) + this.read_bits(1)];
            count = 1 + this.read_rice(width, limit-ranks.len-1);
        } else if op >= 258 && op < 288 {
            rank = 0;
            count = 2 + op-258;
        } else if op >= 288 {
            rank = this.read_huffman(values);
            count = 2 + op-288;
        }
        if ranks.len+count > limit { throw "IronBrew1 Rice block exceeds limit"; }
        ranks.append_byte(rank, count);
        zero = rank == 0;
    }
    [ranks.decode_mtf(if nibble { 4 } else { 0 }), widths]
}

fn decode_context(limit, widths, nibble) {
    let normal = this.codebook(261, false, true);
    let after_zero = this.codebook(261, false, true);
    let after_run = this.codebook(261, false, true);
    let values = this.codebook(256, true, true);
    let zero_values = this.codebook(256, true, true);
    let mode = this.read_bits(2);
    for i in 0..4 {
        if mode == 1 { widths[i] += this.read_bits(2)-1; }
        else if mode >= 2 { widths[i] = this.read_bits(4); }
    }
    let ranks = blob();
    let zero = false;
    let run = false;
    loop {
        let op = this.read_huffman(if run { after_run } else if zero { after_zero } else { normal });
        if op == 260 { break; }
        let count = 1;
        let rank = op;
        if op == 256 || op == 257 {
            rank = if op == 256 { this.read_huffman(if zero { zero_values } else { values }) } else { 0 };
            let width = widths[(if op == 256 { 2 } else { 0 }) + this.read_bits(1)];
            count = 1 + this.read_rice(width, limit-ranks.len-1);
        } else if op == 258 {
            rank = 0;
            count = 2 + this.read_bits(5);
        } else if op == 259 {
            rank = this.read_huffman(if zero { zero_values } else { values });
            count = 2 + this.read_bits(3);
        }
        if ranks.len+count > limit { throw "IronBrew1 context block exceeds limit"; }
        ranks.append_byte(rank, count);
        zero = rank == 0;
        run = op >= 256;
    }
    [ranks.decode_mtf(if nibble { 4 } else { 8 }), widths]
}

fn decode_prefix(length) {
    let entries = [];
    let count = this.read_gamma()-1;
    if count < 1 || count > 257 { throw "invalid IronBrew1 prefix codebook size"; }
    for i in 0..count {
        let symbol = this.read_gamma();
        let width = this.read_gamma();
        if symbol > 257 || width > 24 { throw "invalid IronBrew1 prefix code"; }
        let code = 0;
        for j in 0..width { code = code*2 + this.read_bits(1); }
        entries.push([symbol,width,code]);
    }
    let table = prefix_huffman(entries);
    let ranks = blob();
    while ranks.len < length {
        let op = this.read_huffman(table);
        if op < 256 {
            ranks.push(op);
        } else {
            let digits = 0;
            while op == 256 && digits < 23 {
                digits += 1;
                op = this.read_huffman(table);
            }
            if op != 257 { throw "invalid IronBrew1 prefix zero-run marker"; }
            let run = 1;
            for i in 0..digits {
                let bit = this.read_huffman(table);
                if bit != 256 && bit != 257 { throw "invalid IronBrew1 prefix zero-run bit"; }
                run = run*2+(bit-256);
            }
            if ranks.len+run > length { throw "IronBrew1 prefix run exceeds block length"; }
            ranks.append_byte(0, run);
        }
    }
    ranks.decode_mtf(0)
}

fn open_pack(text) {
    let encoded = bytes(text);
    byte_cursor(encoded.decode_ascii85())
}

fn unpack(blocks, format, nibble) {
    let output = blob();
    let widths = [0,0,0,0];
    while blocks.remaining > 0 {
        let row = blocks.u32le();
        let size = blocks.u32le();
        let chunk = blocks.substream(size);
        let limit = 4194304-output.len;
        let column = blob();
        if format == "gamma" || format == "prefix" {
            let length = chunk.u32le();
            if length < 1 || row >= length || length > limit {
                throw "invalid IronBrew1 block length or BWT row";
            }
            let bits = bit_cursor_lsb(chunk.take(chunk.remaining));
            if format == "gamma" {
                let table = bits.codebook(257, false, false);
                column = bits.read_mtf_runs(table, length, 256);
            } else { column = bits.decode_prefix(length); }
            if bits.remaining > 7 { throw "trailing IronBrew1 compressed bytes"; }
        } else {
            let bits = bit_cursor_lsb(chunk.take(chunk.remaining));
            let decoded = if format == "rice" {
                bits.decode_rice(limit, widths, nibble)
            } else { bits.decode_context(limit, widths, nibble) };
            column = decoded[0];
            widths = decoded[1];
            if bits.remaining > 7 { throw "trailing IronBrew1 compressed bytes"; }
        }
        output += column.inverse_bwt(row);
    }
    output
}

fn captures() {
    let count = this.vu32();
    if count > 1024 { throw "IronBrew1 capture count exceeds limit"; }
    let output = [];
    for i in 0..count {
        let kind = this.u8();
        if kind > 1 { throw "unknown IronBrew1 capture kind"; }
        output.push([kind,this.u32le()]);
    }
    output
}

fn constant() {
    let kind = this.u8();
    let offset = this.offset;
    let value = ();
    if kind == 0 {
        if this.u8() != 0 { throw "unknown IronBrew1 string encoding"; }
        let size = this.vu32();
        value = this.take(size);
    } else if kind >= 1 && kind <= 4 {
        value = this.u64le();
    } else if kind == 5 {
        value = this.u8();
        if value > 1 { throw "invalid IronBrew1 boolean"; }
    } else if kind != 6 { throw "unknown IronBrew1 constant kind"; }
    [kind,value,offset]
}

fn instruction(layout) {
    let header = this.read_record("vu32 u8[3] u8");
    let op = header[0];
    let flags = header[1];
    let mode = header[2];
    if mode > 3 || flags[0] > 1 || flags[1] > 1 || flags[2] > 1 {
        throw "invalid IronBrew1 instruction descriptor at byte " + this.offset;
    }
    let count = if mode == 0 {1} else {this.u16le()};
    let width = if layout == "rice" { [3,3,2,1][mode] } else { [5,5,2,1][mode] };
    if count > 1024 { throw "IronBrew1 operand group count exceeds limit"; }
    let operands = this.u32_rows_le(count,width);
    let extra = if layout == "rice" { [] } else { this.u32s_le(5) };
    [op,flags,mode,operands,extra]
}

fn prototype(depth, layout) {
    if depth > 24 { throw "IronBrew1 prototype nesting exceeds limit"; }
    let constants = [];
    let count = this.vu32();
    if count > min(65536, this.remaining) { throw "IronBrew1 constant count exceeds limit"; }
    for i in 0..count { constants.push(this.constant()); }
    let instructions = [];
    count = this.vu32();
    let minimum = if layout == "rice" { 5 } else { 25 };
    if count < 1 || count > min(65536, this.remaining/minimum) {
        throw "invalid IronBrew1 instruction count " + count;
    }
    for i in 0..count { instructions.push(this.instruction(layout)); }
    let mapping = this.u8();
    if mapping > 1 { throw "unknown IronBrew1 prototype mapping flag"; }
    let optional = if mapping == 1 {this.captures()} else {()};
    let captures = this.captures();
    let groups = [];
    if layout == "rice" {
        count = this.vu32();
        if count > 4096 { throw "IronBrew1 descriptor group count exceeds limit"; }
        for i in 0..count {
            let width = this.vu32();
            if width > 4096 { throw "IronBrew1 descriptor group size exceeds limit"; }
            groups.push(this.read_record("vu32["+width+"]")[0]);
        }
    }
    let parameters = this.u8();
    let vararg = this.u8();
    if vararg > 1 { throw "unknown IronBrew1 vararg flag"; }
    let frame = this.vu32();
    let children = [];
    count = this.vu32();
    if count > 256 { throw "IronBrew1 child count exceeds limit"; }
    for i in 0..count { children.push(this.prototype(depth+1, layout)); }
    #{constants:constants,instructions:instructions,captures:captures,optional:optional,
      parameters:parameters,vararg:vararg,frame:frame,children:children,groups:groups}
}

fn inventory(proto, path) {
    let histogram = #{};
    let instructions = [];
    for pc in 0..proto.instructions.len {
        let record = proto.instructions[pc];
        let key = record[0].to_string();
        histogram[key] = (histogram[key] ?? 0) + 1;
        instructions.push(#{
            pc: pc, opcode: record[0], flags: record[1], mode: record[2],
            operands: record[3], extra: record[4],
        });
    }
    let children = [];
    for i in 0..proto.children.len {
        children.push(inventory(proto.children[i], path + "." + i));
    }
    #{
        path: path, parameters: proto.parameters, variadic: proto.vararg == 1,
        frame: proto.frame, constants: proto.constants, captures: proto.captures,
        optional_captures: proto.optional, descriptor_groups: proto.groups, opcode_counts: histogram,
        instructions: instructions, children: children,
    }
}

fn decode_image(payload, format, nibble) {
    let image = unpack(payload, format, nibble);
    let reader = byte_cursor(image);
    let root = reader.prototype(0, format);
    if reader.remaining != 0 { throw "trailing IronBrew1 prototype bytes"; }
    [image, root]
}

fn discover(source, parse_prototypes) {
    let result = ();
    let issues = #{};
    let tokens = lua_token_buffer(source);
    let nibble = tokens.find_tokens([",","4",")",",","15",")","+","1"], 0) >= 0;
    for candidate in lua_long_strings(source) {
        if candidate.text.len < 32 { continue; }
        let blocks = ();
        try { blocks = open_pack(candidate.text); } catch (error) {
            issues["Ascii85"] = error;
            continue;
        }
        for format in ["gamma", "rice", "context", "prefix"] {
            let decoded = ();
            try {
                decoded = if parse_prototypes {
                    decode_image(blocks, format, nibble)
                } else { [unpack(blocks, format, nibble), ()] };
            } catch (error) {
                issues[format] = error;
                continue;
            }
            if result != () { throw "more than one compatible IronBrew1 pack or compression format"; }
            result = [decoded, [candidate.begin, candidate.end], format];
        }
    }
    if result == () { throw "IronBrew1 pack discovery failed: " + issues.to_string(); }
    result
}
