frontend
// shortcut: audited one-stage loader graph, extend with verified IronBrew1 dispatchers.
fn ascii85(text) {
    let input = bytes(text);
    let output = blob();
    if input.len % 5 == 1 { throw "invalid IronBrew1 Base85 tail"; }
    for at in range(0,input.len,5) {
        let width = min(5,input.len-at);
        let word = 0;
        for i in 0..5 {
            let byte = if i < width { input[at+i] } else { 117 };
            if byte < 33 || byte > 117 { throw "invalid IronBrew1 Base85 digit"; }
            word = word*85 + byte-33;
        }
        if word > 0xffffffff { throw "IronBrew1 Base85 word overflow"; }
        for i in 0..(width-1) { output.push((word >> (24-i*8)) & 255); }
    }
    output
}

fn read(data, at, width) {
    if at+width > data.len { throw "truncated IronBrew1 record"; }
    let value = 0;
    for i in 0..width { value |= data[at+i] << (i*8); }
    value
}

fn bit() {
    if this.at >= this.data.len*8 { throw "truncated IronBrew1 bit stream"; }
    let bit = (this.data[this.at/8] >> (this.at%8)) & 1;
    this.at += 1;
    bit
}

fn gamma() {
    let width = 0;
    while this.bit() == 0 {
        width += 1;
        if width > 23 { throw "IronBrew1 gamma code exceeds limit"; }
    }
    let value = 1;
    for i in 0..width { value = (value << 1) | this.bit(); }
    value
}

fn huffman() {
    let count = this.gamma()-1;
    if count < 1 || count > 257 { throw "invalid IronBrew1 Huffman alphabet size"; }
    let lengths = [];
    for i in 0..257 { lengths.push(0); }
    let max_width = 0;
    for i in 0..count {
        let symbol = this.gamma()-1;
        let width = this.gamma();
        if symbol > 256 || width > 24 || lengths[symbol] != 0 {
            throw "invalid IronBrew1 Huffman alphabet entry";
        }
        lengths[symbol] = width;
        max_width = max(max_width,width);
    }
    let table = #{};
    let short_codes = [];
    for i in 0..256 { short_codes.push(()); }
    let code = 0;
    for width in 1..(max_width+1) {
        code <<= 1;
        for symbol in 0..257 {
            if lengths[symbol] != width { continue; }
            if code >= (1 << width) { throw "overlapping IronBrew1 Huffman codes"; }
            table[((1 << width) | code).to_string()] = symbol;
            if width <= 8 {
                let prefix = 0;
                for bit in 0..width { prefix = (prefix << 1) | ((code >> bit) & 1); }
                for suffix in 0..(1 << (8-width)) {
                    short_codes[prefix | (suffix << width)] = [symbol,width];
                }
            }
            code += 1;
        }
    }
    [table,max_width,short_codes]
}

fn symbol(tree) {
    let at = this.at/8;
    let shift = this.at%8;
    if at >= this.data.len { throw "truncated IronBrew1 Huffman symbol"; }
    let index = this.data[at] >> shift;
    if shift != 0 && at+1 < this.data.len {
        index |= (this.data[at+1] << (8-shift)) & 255;
    }
    let short = tree[2][index];
    if short != () {
        if this.at+short[1] > this.data.len*8 { throw "truncated IronBrew1 Huffman code"; }
        this.at += short[1];
        return short[0];
    }
    let code = 1;
    for i in 0..tree[1] {
        code = (code << 1) | this.bit();
        let value = tree[0][code.to_string()];
        if value != () { return value; }
    }
    throw "invalid IronBrew1 Huffman code";
}

fn inverse_bwt(last_column, row) {
    let counts = [];
    for i in 0..256 { counts.push(0); }
    for i in 0..last_column.len { counts[last_column[i]] += 1; }
    let offsets = [];
    let start = 0;
    for count in counts { offsets.push(start); start += count; }
    let links = [];
    for i in 0..last_column.len { links.push(0); }
    for i in 0..last_column.len {
        let byte = last_column[i];
        links[offsets[byte]] = i;
        offsets[byte] += 1;
    }
    let output = blob();
    for i in 0..last_column.len {
        row = links[row];
        output.push(last_column[row]);
    }
    output
}

fn unpack(text) {
    let blocks = ascii85(text);
    let output = blob();
    let at = 0;
    while at < blocks.len {
        let row = read(blocks,at,4);
        let size = read(blocks,at+4,4);
        at += 8;
        if size < 4 || at+size > blocks.len { throw "invalid IronBrew1 compressed block"; }
        let length = read(blocks,at,4);
        if length < 1 || row >= length || output.len+length > 65536 {
            throw "invalid IronBrew1 block length or BWT row";
        }
        let chunk = blob();
        for i in 0..size { chunk.push(blocks[at+i]); }
        at += size;
        let reader = #{data:chunk,at:32};
        let tree = reader.huffman();
        let order = [];
        for byte in 0..256 { order.push(byte); }
        let column = blob();
        while column.len < length {
            let rank = reader.symbol(tree);
            let count = 1;
            if rank == 256 {
                rank = reader.symbol(tree);
                count = reader.gamma();
            }
            if rank >= 256 || column.len+count > length { throw "invalid IronBrew1 move-to-front run"; }
            for i in 0..count {
                let byte = order[rank];
                if rank > 0 { order.remove(rank); order.insert(0,byte); }
                column.push(byte);
            }
        }
        if reader.at < chunk.len*8-7 { throw "trailing IronBrew1 compressed bytes"; }
        output += inverse_bwt(column,row);
    }
    output
}

fn take(width) {
    let value = read(this.data,this.at,width);
    this.at += width;
    value
}

fn varies() {
    let value = 0;
    for i in 0..5 {
        let byte = this.take(1);
        value |= (byte & 127) << (i*7);
        if byte < 128 {
            if value > 0xffffffff { throw "IronBrew1 variable integer overflow"; }
            return value;
        }
    }
    throw "invalid IronBrew1 variable integer";
}

fn captures() {
    let count = this.varies();
    if count > 1024 { throw "IronBrew1 capture count exceeds limit"; }
    let output = [];
    for i in 0..count {
        let kind = this.take(1);
        if kind > 1 { throw "unknown IronBrew1 capture kind"; }
        output.push([kind,this.take(4)]);
    }
    output
}

fn constant() {
    let kind = this.take(1);
    let offset = this.at;
    let value = ();
    if kind == 0 {
        if this.take(1) != 0 { throw "unknown IronBrew1 string encoding"; }
        let size = this.varies();
        if size > this.data.len-this.at { throw "truncated IronBrew1 string"; }
        value = blob();
        for i in 0..size { value.push(this.take(1)); }
    } else if kind >= 1 && kind <= 4 {
        value = this.take(8);
    } else if kind == 5 {
        value = this.take(1);
        if value > 1 { throw "invalid IronBrew1 boolean"; }
    } else if kind != 6 { throw "unknown IronBrew1 constant kind"; }
    [kind,value,offset]
}

fn instruction() {
    let op = this.varies();
    let flags = [this.take(1),this.take(1),this.take(1)];
    let mode = this.take(1);
    if mode > 3 || flags[0] > 1 || flags[1] > 1 || flags[2] > 1 {
        throw "invalid IronBrew1 instruction descriptor";
    }
    let count = if mode == 0 {1} else {this.take(2)};
    let width = [5,5,2,1][mode];
    if count > 1024 { throw "IronBrew1 operand group count exceeds limit"; }
    let operands = [];
    for i in 0..count {
        let record = [];
        for j in 0..width { record.push(this.take(4)); }
        operands.push(record);
    }
    let extra = [];
    for i in 0..5 { extra.push(this.take(4)); }
    [op,flags,mode,operands,extra]
}

fn prototype(depth) {
    if depth > 24 { throw "IronBrew1 prototype nesting exceeds limit"; }
    let constants = [];
    let count = this.varies();
    if count > 4096 { throw "IronBrew1 constant count exceeds limit"; }
    for i in 0..count { constants.push(this.constant()); }
    let instructions = [];
    count = this.varies();
    if count < 1 || count > 4096 { throw "invalid IronBrew1 instruction count"; }
    for i in 0..count { instructions.push(this.instruction()); }
    let mapping = this.take(1);
    if mapping > 1 { throw "unknown IronBrew1 prototype mapping flag"; }
    let optional = if mapping == 1 {this.captures()} else {()};
    let captures = this.captures();
    let parameters = this.take(1);
    let vararg = this.take(1);
    if vararg > 1 { throw "unknown IronBrew1 vararg flag"; }
    let frame = this.varies();
    let children = [];
    count = this.varies();
    if count > 256 { throw "IronBrew1 child count exceeds limit"; }
    for i in 0..count { children.push(this.prototype(depth+1)); }
    #{constants:constants,instructions:instructions,captures:captures,optional:optional,
      parameters:parameters,vararg:vararg,frame:frame,children:children}
}

fn quote(data) {
    let output = "\"";
    for i in 0..data.len {
        let byte = data[i];
        if byte == 34 || byte == 92 { output += "\\" + byte_char(byte); }
        else if byte >= 32 && byte <= 126 { output += byte_char(byte); }
        else { output += "\\" + (byte/100).to_string() + (byte/10%10).to_string() + (byte%10).to_string(); }
    }
    output+"\""
}

let text = source;
text.replace("\r\n","\n");
text.trim();
let marker = "bb=ba([==[";
let parts = text.split(marker);
if parts.len != 2 { throw "IronBrew1 audited pack marker not found"; }
let close = parts[1].index_of("]==]");
if close < 0 { throw "unterminated IronBrew1 pack"; }
let wrapper = parts[0]+marker+"<pack>"+parts[1].sub_string(close);
if sha256(wrapper) != "4489bc2900f3081a20c52b76704eec1833dd21953c88f9edb10f5d0d7c5a48f5" {
    throw "unsupported IronBrew1 VM wrapper";
}

let image = unpack(parts[1].sub_string(0,close));
let reader = #{data:image,at:0};
let root = reader.prototype(0);
if reader.at != image.len { throw "trailing IronBrew1 prototype bytes"; }
if root.constants.len != 41 { throw "unsupported IronBrew1 loader constants"; }
let normalized = image;
let variable_constants = [0];
for index in 8..37 { variable_constants.push(index); }
for index in variable_constants {
    let record = root.constants[index];
    if record[0] != 1 || record[1] < 0 || record[1] > 255 {
        throw "invalid IronBrew1 string byte or XOR key";
    }
    for i in 0..8 { normalized[record[2]+i] = 0; }
}
// The graph binds the two instruction patches to their preceding writes and
// proves the XOR fallback and the captured string decoder. Only bytes vary.
if sha256(normalized) != "a03d8d85e6d7fdb81c44c122431a4ad7f1ddff04afcab49577ac802363cff901" {
    throw "unsupported IronBrew1 payload graph";
}

let endpoint = blob();
let key = root.constants[0][1];
for pair in root.instructions[29][3] {
    endpoint.push(root.constants[pair[1]][1] ^ key);
}
// The VM packs the fetch result, then unpacks through the table's length.
"local unpack_values = table.unpack or unpack\n"+
"local environment = (getfenv or function() return _ENV end)()\n"+
"local compile = environment.loadstring\n"+
"local game = environment.game\n"+
"local response = {game:HttpGet("+quote(endpoint)+")}\n"+
"local chunk = compile(unpack_values(response, 1, #response))\n"+
"chunk()\n"
%%
