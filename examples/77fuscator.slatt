frontend
// shortcut: audited 0.6.0 raw-LZW dispatchers, with per-wrapper word layouts.
let text = source;
text.replace("\r\n", "\n");
text.trim();
let marker = "return a(k(),{})();end)('";
let parts = text.split(marker);
let second = false;
if parts.len != 2 {
    marker = "return a(bi(),{})();end)('";
    parts = text.split(marker);
    second = true;
}
if parts.len != 2 { throw "77fuscator raw payload not found"; }
let close = parts[1].index_of("'");
if close < 0 { throw "unterminated 77fuscator payload"; }
let expected = if second { "8b7b858e5e3f706fd15fe7fac738ec3bc31e56a27d976c0b9a3887a97a6364d3" }
               else { "6353144b18aba077b2d31552a8bd33b3e7e6602ff9ca866a690b342cf11a3aaa" };
if sha256(parts[0] + marker + parts[1].sub_string(close)) != expected {
    throw "unsupported 77fuscator wrapper";
}

fn digit(byte) {
    if byte >= 48 && byte <= 57 { return byte - 48; }
    if byte >= 65 && byte <= 90 { return byte - 55; }
    throw "invalid 77fuscator base36 digit";
}
let encoded = bytes(parts[1].sub_string(0,close));
let dictionary = [];
for byte in 0..256 { dictionary.push([byte]); }
let cursor = 0;
let image = [];
let previous = [];
// Exact integer state initializers in the two audited wrappers.
let xor_byte = if second { 62 } else { 230 };
while cursor < encoded.len {
    let width = digit(encoded[cursor]);
    cursor += 1;
    if width < 1 || width > 8 || cursor + width > encoded.len { throw "invalid 77fuscator LZW code"; }
    let code = 0;
    for i in 0..width { code = code*36 + digit(encoded[cursor+i]); }
    cursor += width;
    let current;
    if code < dictionary.len { current = dictionary[code]; }
    else if code == dictionary.len && previous.len > 0 { current = previous + [previous[0]]; }
    else { throw "invalid 77fuscator dictionary reference"; }
    if previous.len > 0 { dictionary.push(previous + [current[0]]); }
    if image.len + current.len > 65536 { throw "77fuscator image exceeds current frontend limit"; }
    for value in current { image.push(value ^ xor_byte); }
    previous = current;
}

fn read(data, offset, width) {
    if offset + width > data.len { throw "truncated 77fuscator record"; }
    let value = 0;
    for i in 0..width { value |= data[offset+i] << (8*i); }
    value
}
fn bits(value, low, width) { (value >> low) & ((1 << width)-1) }
fn quote(data, offset, length) {
    if offset + length > data.len { throw "truncated 77fuscator constant"; }
    let result = "\"";
    for i in 0..length {
        let byte = data[offset+i];
        if byte >= 32 && byte <= 126 && byte != 34 && byte != 92 { result += byte_char(byte); }
        else { result += "\\" + (byte/100).to_string() + (byte/10%10).to_string() + (byte%10).to_string(); }
    }
    result + "\""
}
fn integer_constant(word) {
    if word == 0 { return "0"; }
    let exponent = bits(word,52,11) - 1023;
    if word < 0 || exponent < 0 || exponent > 52 { throw "unsupported 77fuscator number"; }
    let mantissa = bits(word,0,52) | (1 << 52);
    let shift = 52 - exponent;
    if bits(mantissa,0,shift) != 0 { throw "unsupported fractional 77fuscator number"; }
    (mantissa >> shift).to_string()
}
cursor = 0;
if !second {
    if read(image,cursor,1) != 0 { throw "unsupported 77fuscator parameters"; }
    cursor += 1;
}
let count = read(image,cursor,4);
if count < 1 || count > 90 { throw "unsupported 77fuscator instruction count"; }
let instructions = [];
cursor += 4;
let word_xor = if second { [188,55] } else { [89,207] };
for pc in 0..count {
    let low = read(image,cursor,4) ^ word_xor[0];
    let high = read(image,cursor+4,4) ^ word_xor[1];
    cursor += 8;
    let shape = bits(low,0,2);
    let b = if shape == 0 { bits(low,11,9) }
            else if shape == 1 { bits(high,11,22) }
            else { bits(high,11,21) - 1048575 };
    let c = if shape == 0 || shape == 3 { bits(low,20,9) } else { () };
    instructions.push([bits(high,0,11), bits(low,2,9), b, c]);
}
if read(image,cursor,4) != 0 { throw "unsupported 77fuscator child prototypes"; }
cursor += 4;
if second {
    if read(image,cursor,1) != 0 { throw "unsupported 77fuscator parameters"; }
    cursor += 1;
}
let const_count = read(image,cursor,4);
if const_count > 1024 { throw "unsupported 77fuscator constant count"; }
cursor += 4;
let constants = [()];
let tags = if second { [1,2,0,3] } else { [0,1,3,2] };
for i in 0..const_count {
    let tag = read(image,cursor,1);
    cursor += 1;
    if tag == tags[0] {
        if read(image,cursor,1) != 0 { throw "unsupported 77fuscator special string"; }
        let length = read(image,cursor+1,4);
        cursor += 5;
        constants.push(quote(image,cursor,length)); cursor += length;
    } else if tag == tags[1] {
        constants.push(integer_constant(read(image,cursor,8)));
        cursor += 8;
    } else if tag == tags[2] {
        constants.push(if read(image,cursor,1) == 0 { "false" } else { "true" });
        cursor += 1;
    } else if tag == tags[3] { constants.push("nil"); }
    else { throw "unknown 77fuscator constant tag"; }
}
if cursor != image.len { throw "trailing 77fuscator data"; }

fn constant(constants, index) {
    if index == () || index < 1 || index >= constants.len { throw "invalid 77fuscator constant"; }
    constants[index]
}
fn reg(registers, index) { registers[index.to_string()] ?? "nil" }
fn normalize_second(row) {
    let op=row[0]; let a=row[1]; let b=row[2]; let c=row[3];
    if op == 11 { return [0,a,b,c]; }
    if op == 6 { return [9,a,b,c]; }
    if op == 0 { return [4,a,a+1,c]; }
    if op == 1 && c != () { return [10,c+1,b,c]; }
    if op == 2 { return [1,a,b,c]; }
    if op == 3 || op == 9 { return [11,b,a,c]; }
    if op == 8 { return [5,a,b,c]; }
    if op == 13 { return [7,a,b,c]; }
    if op == 12 { return [4,a,b,c]; }
    if op == 7 { return [10,a,b,c]; }
    if op == 5 { return [6,a,b,c]; }
    [-1,a,b,c]
}
fn invoke(registers, base, last) {
    if base == () || last == () || last < base || last - base > 32 {
        throw "unsupported 77fuscator argument range";
    }
    let target = reg(registers,base);
    if target == "nil" { throw "unbound 77fuscator invoke target"; }
    let invocation = target + "(";
    for i in (base+1)..(last+1) {
        if i > base+1 { invocation += ", "; }
        invocation += reg(registers,i);
    }
    invocation + ")"
}
let output = "local environment = (getfenv or function() return _ENV end)()\n";
let registers = #{};
let returned = false;
for pc in 0..instructions.len {
    let row = if second { normalize_second(instructions[pc]) } else { instructions[pc] };
    let op=row[0]; let a=row[1]; let b=row[2]; let c=row[3];
    if op == 3 || op == 6 {
        // The audited dispatcher exits the function here. No earlier supported
        // instruction changes the PC, so subsequent physical words are unreachable.
        returned = true;
        break;
    }
    let dest = a;
    let expr;
    if op == 0 { expr = "environment[" + constant(constants,b) + "]"; }
    else if op == 1 { expr = reg(registers,b) + "[" + constant(constants,c) + "]"; }
    else if op == 11 {
        if c == () { throw "missing 77fuscator table destination"; }
        dest = c;
        expr = reg(registers,b) + "[" + constant(constants,a) + "]";
    } else if op == 9 { expr = constant(constants,b); }
    else if op == 5 || op == 7 {
        let receiver = if op == 5 { reg(registers,a) } else { reg(registers,b) };
        if op == 5 && c == () { throw "missing 77fuscator method destination"; }
        dest = if op == 5 { c } else { a };
        registers[(dest+1).to_string()] = receiver;
        expr = receiver + "[" + constant(constants,if op == 5 { b } else { c }) + "]";
    } else if op == 8 { expr = invoke(registers,a,b); }
    else if op == 4 || op == 10 {
        output += (if op == 4 { invoke(registers,a,b) } else { invoke(registers,c,a) }) + "\n";
        continue;
    } else { throw "unclassified reachable 77fuscator instruction at " + (pc+1).to_string(); }
    let name = "value" + (pc+1).to_string();
    registers[dest.to_string()] = name;
    output += "local " + name + " = " + expr + "\n";
}
if !returned { throw "missing 77fuscator return"; }
output
%%
